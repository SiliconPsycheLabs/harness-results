     "sql": "SELECT customers.name AS Cliente, SUM(order_lines.quantity * products.unit_price) AS Importe FROM orders JOIN order_lines ON orders.id = order_lines.order_id JOIN products ON order_lines.product_id = products.id JOIN customers ON orders.customer_id = customers.id WHERE customers.country = 'IT' AND orders.order_date BETWEEN '2025-01-01' AND '2025-12-31' GROUP BY customers.name;"
